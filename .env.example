# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ==============================
# BACKEND (apps/api/.env)
# ==============================

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://copawill:copawill@localhost:5432/copawill

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-this-to-another-strong-random-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Email (configure com seu provedor SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="Copa Will <noreply@copawill.com>"

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=copa-will-assets
AWS_REGION=us-east-1
# Para R2, use: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=

# ==============================
# FRONTEND (apps/web/.env.local)
# ==============================

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
